$RECYCLE.BIN/

# Editor & IDE Directories
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Dependency & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build Outputs & Bundlers
dist/
build/
out/
.cache/
.parcel-cache/
.turbo/
.next/
.nuxt/

